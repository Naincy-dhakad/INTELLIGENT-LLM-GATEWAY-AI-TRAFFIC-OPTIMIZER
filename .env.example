# Backend-safe local development settings. Do not put provider credentials here.
APP_NAME=Intelligent LLM Gateway
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_PROVIDER_ID=phase3-mock

# Gateway caller authentication is disabled for local mock development.
# When enabled, provide comma-separated local development keys; never commit real keys.
GATEWAY_AUTH_ENABLED=false
GATEWAY_API_KEYS=

# Gateway rate limiting is disabled by default and requires gateway authentication.
RATE_LIMIT_ENABLED=false
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Durable usage tracking is disabled by default and requires PostgreSQL when enabled.
USAGE_TRACKING_ENABLED=false
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME

# Backend-only provider configuration. Leave credentials blank for mock-only local development.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# Ollama is optional and requires no API key.
OLLAMA_BASE_URL=
OLLAMA_DEFAULT_MODEL=llama3.2

# Reserved for later phases; intentionally unset.
# DATABASE_URL=
# REDIS_URL=

# Management metrics are disabled by default and bind locally when enabled.
METRICS_ENABLED=false
METRICS_MANAGEMENT_ENABLED=false
METRICS_BIND_HOST=127.0.0.1
METRICS_BIND_PORT=9090
METRICS_AUTH_MODE=mtls
METRICS_OPERATOR_TOKEN=
