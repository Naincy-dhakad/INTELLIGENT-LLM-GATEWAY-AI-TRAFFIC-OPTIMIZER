# Backend-only settings. Copy to ../../.env for local use; never commit .env.
APP_NAME=Intelligent LLM Gateway
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_PROVIDER_ID=phase3-mock

# Gateway caller authentication is disabled for local mock development.
# When enabled, provide comma-separated local development keys; never commit real keys.
GATEWAY_AUTH_ENABLED=false
GATEWAY_API_KEYS=

# Gateway rate limiting is disabled by default and requires gateway authentication.
RATE_LIMIT_ENABLED=false
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Durable usage tracking is disabled by default and requires PostgreSQL when enabled.
USAGE_TRACKING_ENABLED=false
DATABASE_URL=postgresql+psycopg://gateway:gateway@localhost:5432/gateway
# Normalized USD per 1,000,000 input/output tokens for deterministic cost routing.
PHASE3_MOCK_INPUT_USD_PER_MILLION_TOKENS=1
PHASE3_MOCK_OUTPUT_USD_PER_MILLION_TOKENS=2
PHASE3_MOCK_LATENCY_MS=100
# 0-100; >=80 healthy, >=40 degraded, otherwise unavailable.
PHASE3_MOCK_HEALTH_SCORE=100

# Leave credentials blank for mock-only local development. Never commit real keys.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# Optional local Ollama endpoint; no API key is required.
OLLAMA_BASE_URL=
OLLAMA_DEFAULT_MODEL=llama3.2
